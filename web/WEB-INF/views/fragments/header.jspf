<%-- 
    AITA — 24/7 LLM Tutor Platform
    Fragment: header.jspf (Common CSS, Fonts & Head definitions)
--%>
<%@page pageEncoding="UTF-8"%>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<!-- Bootstrap Icons CDN -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<!-- Application Global Stylesheet -->
<link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/app.css">
<!-- Script chống giật theme (FOUC) -->
<script>
    (function() {
        var t = localStorage.getItem('aita_theme_pref') || 'dark';
        document.documentElement.setAttribute('data-theme', t);
        if (window.innerWidth > 900 && localStorage.getItem('aita_sidebar_collapsed') === 'true') {
            document.documentElement.classList.add('sidebar-collapsed-preload');
        }
    })();
</script>
