<%-- 
    AITA — 24/7 LLM Tutor Platform
    Fragment: topbar.jspf (Sticky Topbar, Global Search, Theme Switcher, Notifications & Logout)
--%>
<%@page pageEncoding="UTF-8"%>
<%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>

<header class="app-topbar">
    <div class="topbar-left">
        <!-- Nút thu gọn / mở sidebar (Desktop & Mobile) -->
        <button type="button" class="btn-sidebar-toggle" aria-label="Đóng mở thanh điều hướng" title="Thu gọn / Mở rộng Sidebar">
            <i class="bi bi-list"></i>
        </button>

        <!-- Breadcrumbs -->
        <div class="breadcrumbs">
            <a href="${sessionScope.role eq 'ADMIN' or sessionScope.currentUser.role_id == 1 ? pageContext.request.contextPath.concat('/user') : '#'}">AITA</a>
            <i class="bi bi-chevron-right" style="font-size:11px"></i>
            <span>
                <c:choose>
                    <c:when test="${pageContext.request.servletPath eq '/chat.jsp'}">AI Tutor Chatbot 24/7</c:when>
                    <c:when test="${pageContext.request.servletPath eq '/classes.jsp'}">Lớp học phụ trách</c:when>
                    <c:when test="${pageContext.request.servletPath eq '/profile.jsp'}">Hồ sơ cá nhân & Tài khoản</c:when>
                    <c:when test="${pageContext.request.servletPath eq '/add.jsp'}">Thêm người dùng</c:when>
                    <c:when test="${pageContext.request.servletPath eq '/update.jsp'}">Chỉnh sửa người dùng</c:when>
                    <c:otherwise>Quản trị Hệ thống</c:otherwise>
                </c:choose>
            </span>
        </div>
    </div>

    <!-- Ô tìm kiếm nhanh trên Topbar -->
    <div class="topbar-search-wrapper">
        <i class="bi bi-search topbar-search-icon"></i>
        <input type="text" class="topbar-search-input" id="topbarSearch" 
               placeholder="Tìm nhanh thành viên, mã lớp, email..." 
               onkeyup="if(window.filterUserTable){var el=document.getElementById('tableSearchInput'); if(el){el.value=this.value; filterUserTable();}}" />
    </div>

    <!-- Khu vực nút công cụ bên phải Topbar -->
    <div class="topbar-right">
        <!-- AI Tutor Status Indicator -->
        <div class="status-pill">
            <span class="status-dot-pulse"></span>
            <span>AI Tutor: Online</span>
        </div>

        <!-- Chuông thông báo -->
        <button type="button" class="icon-action-btn" aria-label="Thông báo hệ thống" title="Thông báo mới">
            <i class="bi bi-bell"></i>
            <span class="icon-badge"></span>
        </button>

        <!-- Nút chuyển đổi Dark Mode / Light Mode -->
        <button type="button" class="icon-action-btn btn-theme-toggle" aria-label="Đổi giao diện sáng/tối" title="Đổi giao diện sáng/tối">
            <i class="bi bi-sun-fill"></i>
        </button>

        <!-- Nút Tài Khoản & Menu Thả Xuống (Hover hoặc Click) -->
        <div class="topbar-user-menu-wrapper" id="topbarUserMenuWrapper">
            <button type="button" class="btn-topbar-user" id="btnTopbarUserToggle" aria-haspopup="true" aria-expanded="false" title="Nhấp hoặc rê chuột để mở tùy chọn tài khoản">
                <div class="topbar-avatar-circle">
                    <c:choose>
                        <c:when test="${not empty sessionScope.currentUser}">
                            ${sessionScope.currentUser.full_name.substring(0, 1).toUpperCase()}
                        </c:when>
                        <c:otherwise>U</c:otherwise>
                    </c:choose>
                </div>
                <div class="topbar-user-text">
                    <span class="topbar-user-name">
                        <c:choose>
                            <c:when test="${not empty sessionScope.currentUser}">
                                ${sessionScope.currentUser.full_name}
                            </c:when>
                            <c:otherwise>Người dùng</c:otherwise>
                        </c:choose>
                    </span>
                    <span class="topbar-user-role">
                        <c:choose>
                            <c:when test="${sessionScope.role eq 'ADMIN' or sessionScope.currentUser.role_id == 1}">Quản trị viên</c:when>
                            <c:when test="${sessionScope.role eq 'INSTRUCTOR' or sessionScope.currentUser.role_id == 2}">Giảng viên</c:when>
                            <c:otherwise>Sinh viên</c:otherwise>
                        </c:choose>
                    </span>
                </div>
                <i class="bi bi-chevron-down topbar-chevron"></i>
            </button>

            <!-- Dropdown Menu Tài khoản -->
            <div class="topbar-user-dropdown" id="topbarUserDropdown">
                <div class="dropdown-user-header">
                    <div class="dropdown-avatar">
                        <c:choose>
                            <c:when test="${not empty sessionScope.currentUser}">
                                ${sessionScope.currentUser.full_name.substring(0, 1).toUpperCase()}
                            </c:when>
                            <c:otherwise>U</c:otherwise>
                        </c:choose>
                    </div>
                    <div class="dropdown-info">
                        <div class="dropdown-name">
                            <c:choose>
                                <c:when test="${not empty sessionScope.currentUser}">
                                    ${sessionScope.currentUser.full_name}
                                </c:when>
                                <c:otherwise>Người dùng</c:otherwise>
                            </c:choose>
                        </div>
                        <div class="dropdown-email">
                            <c:out value="${sessionScope.currentUser.email != null ? sessionScope.currentUser.email : 'user@aita.edu.vn'}" />
                        </div>
                        <span class="dropdown-role-badge">
                            <c:choose>
                                <c:when test="${sessionScope.role eq 'ADMIN' or sessionScope.currentUser.role_id == 1}">Quản trị viên</c:when>
                                <c:when test="${sessionScope.role eq 'INSTRUCTOR' or sessionScope.currentUser.role_id == 2}">Giảng viên</c:when>
                                <c:otherwise>Sinh viên</c:otherwise>
                            </c:choose>
                        </span>
                    </div>
                </div>

                <div class="dropdown-divider"></div>

                <div class="dropdown-menu-list">
                    <!-- Quản lý tài khoản (Đổi SĐT, email, mật khẩu) -->
                    <a href="${pageContext.request.contextPath}/profile" class="dropdown-item">
                        <i class="bi bi-person-gear"></i>
                        <div class="item-text">
                            <strong>Quản lý tài khoản</strong>
                            <span>Đổi SĐT, email, mật khẩu</span>
                        </div>
                    </a>

                    <!-- Cài đặt (Mở modal cài đặt) -->
                    <button type="button" class="dropdown-item" id="btnTopbarSettings">
                        <i class="bi bi-gear-fill"></i>
                        <div class="item-text">
                            <strong>Cài đặt hệ thống</strong>
                            <span>Tùy chỉnh nền tảng & AI</span>
                        </div>
                    </button>
                </div>

                <div class="dropdown-divider"></div>

                <div class="dropdown-menu-list">
                    <!-- Đăng xuất -->
                    <a href="${pageContext.request.contextPath}/logout" class="dropdown-item text-danger">
                        <i class="bi bi-box-arrow-right"></i>
                        <div class="item-text">
                            <strong>Đăng xuất</strong>
                            <span>Thoát khỏi phiên làm việc</span>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
</header>
